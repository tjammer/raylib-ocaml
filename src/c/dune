(executable
 (name apply_patch)
 (modules Apply_patch)
 (libraries patch))

(executable
 (name chmodx)
 (modules Chmodx)
 (libraries unix))

(rule
 (targets library_flags.sexp raylib_flags raylib_target)
 (action
  (progn
   (copy config/library_flags.sexp library_flags.sexp)
   (copy config/raylib_flags raylib_flags)
   (copy config/raylib_target raylib_target))))

(data_only_dirs vendor)

(rule
 (alias build-raylib)
 (package raylib)
 (targets libraylib.a dllraylib.so)
 (enabled_if
  (= %{read-lines:config/raylib_target} linux))
 (deps
  (source_tree vendor/raylib)
  enable_formats.patch
  (env_var GRAPHICS)
  (env_var RAYLIB_CONFIG_FLAGS))
 (action
  (progn
   (run %{exe:chmodx.exe} vendor/raylib/src/config.h)
   (run %{exe:apply_patch.exe} enable_formats.patch)
   (no-infer
    (progn
     (run make -C vendor/raylib/src %{read-lines:raylib_flags} clean)
     (run
      make
      -C
      vendor/raylib/src
      %{read-lines:raylib_flags}
      RAYLIB_LIBTYPE=STATIC
      -j
      8)
     (copy vendor/raylib/src/libraylib.a libraylib.a)
     (run make -C vendor/raylib/src %{read-lines:raylib_flags} clean)
     (run
      make
      -C
      vendor/raylib/src
      %{read-lines:raylib_flags}
      RAYLIB_LIBTYPE=SHARED
      -j
      8)
     (copy vendor/raylib/src/libraylib.so dllraylib.so))))))

