(rule
 (alias build-raylib)
 (package raylib)
 (targets libraylib.a dllraylib.so)
 (enabled_if
  (= %{read-lines:config/raylib_target} bsd))
 (deps
  (source_tree vendor/raylib)
  enable_formats.patch
  freebsd.patch
  (env_var GRAPHICS)
  (env_var RAYLIB_CONFIG_FLAGS))
 (action
  (progn
   (run %{exe:chmodx.exe} vendor/raylib/src/config.h)
   (run %{exe:apply_patch.exe} enable_formats.patch)
   (run %{exe:chmodx.exe} vendor/raylib/src/Makefile)
   (run %{exe:apply_patch.exe} freebsd.patch)
   (no-infer
    (progn
     (run gmake -C vendor/raylib/src %{read-lines:raylib_flags} clean)
     (run
      gmake
      -C
      vendor/raylib/src
      %{read-lines:raylib_flags}
      RAYLIB_LIBTYPE=STATIC
      -j
      8)
     (copy vendor/raylib/src/libraylib.a libraylib.a)
     (run gmake -C vendor/raylib/src %{read-lines:raylib_flags} clean)
     (run
      gmake
      -C
      vendor/raylib/src
      %{read-lines:raylib_flags}
      RAYLIB_LIBTYPE=SHARED
      -j
      8)
     (copy vendor/raylib/src/libraylib.so dllraylib.so))))))

(rule
 (alias build-raylib)
 (package raylib)
 (targets libraylib.a dllraylib.so)
 (enabled_if
  (= %{read-lines:config/raylib_target} web))
 (deps
  (source_tree vendor/raylib)
  enable_formats.patch
  (env_var GRAPHICS)
  (env_var RAYLIB_CONFIG_FLAGS))
 (action
  (progn
   (run %{exe:chmodx.exe} vendor/raylib/src/config.h)
   (run %{exe:apply_patch.exe} enable_formats.patch)
   (no-infer
    (progn
     (run make -C vendor/raylib/src %{read-lines:raylib_flags} clean)
     (run
      make
      -C
      vendor/raylib/src
      %{read-lines:raylib_flags}
      RAYLIB_LIBTYPE=STATIC
      -j
      8)
     (copy vendor/raylib/src/libraylib.web.a libraylib.a)
     ; Dune's bytecode link checks expect a host DLL for foreign_archives.
     ; The wasm program links the static lib, the shared one just needs
     ; to exist.
     (system "%{env:HOST_CC=cc} -shared -x c %{null} -o dllraylib.so"))))))
